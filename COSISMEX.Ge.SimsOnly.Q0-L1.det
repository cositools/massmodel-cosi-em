#------------------------------------------------------------
# Detector information:

# Attention this is the detector information for the SIMULATIONS, not for revan
# In ortder to ensure it is not usedf for the normal analysis, the trigger threshold is set x100 higher

Strip3D               GeD_1

GeD_1.SensitiveVolume      GeWafer_Q0-L1
GeD_1.DetectorVolume       GeWafer_Q0-L1

GeD_1.Offset               0.0 0.0
GeD_1.StripNumber          2048 2048

GeD_1.EnergyResolution   Gauss     0.0     0.0    1.04
GeD_1.EnergyResolution   Gauss    100.0    100.0  1.04
GeD_1.EnergyResolution   Gauss    300.0    300.0  1.10
GeD_1.EnergyResolution   Gauss   1000.0   1000.0  1.32
GeD_1.EnergyResolution   Gauss   3000.0   3000.0  1.94
GeD_1.EnergyResolution   Gauss  10000.0  10000.0  4.14

# Both
GeD_1.DepthResolutionThreshold 25.0
GeD_1.DepthResolution      0.0  { 0.084 / 2.35 }
GeD_1.DepthResolution     25.0  { 0.084 / 2.35 }
GeD_1.DepthResolution     50.0  { 0.070 / 2.35 }
GeD_1.DepthResolution    100.0  { 0.060 / 2.35 }
GeD_1.DepthResolution    200.0  { 0.052 / 2.35 }
GeD_1.DepthResolution    500.0  { 0.042 / 2.35 }
GeD_1.DepthResolution   1000.0  { 0.036 / 2.35 }
GeD_1.DepthResolution   2000.0  { 0.031 / 2.35 }
GeD_1.DepthResolution   5000.0  { 0.031 / 2.35 }

GeD_1.TriggerThreshold     13.
GeD_1.NoiseThresholdEqualsTriggerThreshold  True



Simple GuardRingDetector_GeD_1

GuardRingDetector_GeD_1.SensitiveVolume     GeWaferGuardRing_Q0-L1
GuardRingDetector_GeD_1.DetectorVolume      GeWaferGuardRing_Q0-L1

GuardRingDetector_GeD_1.TriggerThreshold      40
GuardRingDetector_GeD_1.NoiseThresholdEqualsTriggerThreshold true

GuardRingDetector_GeD_1.EnergyResolution Gaus 10      10        3
GuardRingDetector_GeD_1.EnergyResolution Gaus 20      20        3
GuardRingDetector_GeD_1.EnergyResolution Gaus 50      50        3
GuardRingDetector_GeD_1.EnergyResolution Gaus 100     100       3
GuardRingDetector_GeD_1.EnergyResolution Gaus 200     200       3
GuardRingDetector_GeD_1.EnergyResolution Gaus 500     500       3
GuardRingDetector_GeD_1.EnergyResolution Gaus 1000    1000      3
GuardRingDetector_GeD_1.EnergyResolution Gaus 2000    2000      3
GuardRingDetector_GeD_1.EnergyResolution Gaus 5000    5000      3



#------------------------------------------------------------
# Trigger information:

Trigger Trigger_GeD_1
Trigger_GeD_1.Detector GeD_1 1
Trigger_GeD_1.TriggerByChannel true
Trigger_GeD_1.Veto false

Trigger GuardRingVeto_GeD_1
GuardRingVeto_GeD_1.Veto true
GuardRingVeto_GeD_1.TriggerByChannel true
GuardRingVeto_GeD_1.Detector GuardRingDetector_GeD_1 1



