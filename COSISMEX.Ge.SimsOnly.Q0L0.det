#------------------------------------------------------------
# Detector information:

# Attention this is the detector information for the SIMULATIONS, not for revan
# In ortder to ensure it is not usedf for the normal analysis, the trigger threshold is set x100 higher
Include COSISMEX.Ge.DetectorBuild.Q0L0.geo


Simple               GeD_0

# The GeD volume for the simulations includes both the 3D strip volume and the GR in WholeWafer
Volume GeWafer_Q0_L0
GeWafer_Q0_L0.Material active_ge_recoil
GeWafer_Q0_L0.Visibility 1
GeWafer_Q0_L0.Color 4
GeWafer_Q0_L0.Shape WholeWafer_Q0_L0
GeWafer_Q0_L0.Mother Detector_Q0_L0
GeWafer_Q0_L0.Position {-0.6555 + Xshift} {0.0 + Yshift} {Zshift} 


GeD_0.SensitiveVolume      GeWafer_Q0_L0
GeD_0.DetectorVolume       GeWafer_Q0_L0

GeD_0.Offset               0.0 0.0
GeD_0.StripNumber          2048 2048

GeD_0.EnergyResolution   Gauss     0.0     0.0    1.04
GeD_0.EnergyResolution   Gauss    100.0    100.0  1.04
GeD_0.EnergyResolution   Gauss    300.0    300.0  1.10
GeD_0.EnergyResolution   Gauss   1000.0   1000.0  1.32
GeD_0.EnergyResolution   Gauss   3000.0   3000.0  1.94
GeD_0.EnergyResolution   Gauss  10000.0  10000.0  4.14


GeD_0.TriggerThreshold     130.
GeD_0.NoiseThresholdEqualsTriggerThreshold  True



#------------------------------------------------------------
# Trigger information:

Trigger Trigger_GeD_0
Trigger_GeD_0.Detector GeD_0 1
Trigger_GeD_0.TriggerByChannel true
Trigger_GeD_0.Veto false




