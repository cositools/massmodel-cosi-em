# A single germanium detector volume
# COSI SMEX model
#These constants were used to make the detector sit nicely in the mother volume
Constant Xshift 1.342
Constant Yshift 0.991
Constant Zshift 0.0

Volume Detector_QQQQ
Detector_QQQQ.Material vacuum
Detector_QQQQ.Shape BRIK  6.1225  5.791  {DetectorHalfHeight+.9+.4}
Detector_QQQQ.Visibility 0
Detector_QQQQ.Virtual true


# Redoing this to follow EXACTLY what is done in special Max
# Create the whole wafer
Shape BRIK WaferOuterBox_QQQQ
WaferOuterBox_QQQQ.Parameters DetectorHalfWidth  DetectorHalfWidth  DetectorHalfHeight

Shape TUBE WaferCutDisk_QQQQ
WaferCutDisk_QQQQ.Parameters 0.0 IngotRadius DetectorHalfHeight

Shape Intersection WholeWafer_QQQQ
WholeWafer_QQQQ.Parameters WaferOuterBox_QQQQ WaferCutDisk_QQQQ

# Create the active wafer
Shape BRIK ActiveWaferOuterBox_QQQQ
ActiveWaferOuterBox_QQQQ.Parameters { DetectorHalfWidth - GuardRingSize }  { DetectorHalfWidth - GuardRingSize }  DetectorHalfHeight

Shape TUBE ActiveWaferCutDisk_QQQQ
ActiveWaferCutDisk_QQQQ.Parameters 0.0 { IngotRadius - GuardRingSize } DetectorHalfHeight

Shape Intersection ActiveWafer_QQQQ
ActiveWafer_QQQQ.Parameters ActiveWaferOuterBox_QQQQ ActiveWaferCutDisk_QQQQ

# Create the guard ring
Shape Subtraction GuardRing_AlmostThere_QQQQ
GuardRing_AlmostThere_QQQQ.Parameters WholeWafer_QQQQ ActiveWafer_QQQQ

# A little trick, to get the Strip detector to work: we have to do another intersection, so that the first volume is a box:
Shape Intersection GuardRing_QQQQ
GuardRing_QQQQ.Parameters WaferOuterBox_QQQQ GuardRing_AlmostThere_QQQQ

Volume GeWafer_QQQQ
GeWafer_QQQQ.Material active_ge_recoil
GeWafer_QQQQ.Visibility 1
GeWafer_QQQQ.Color 4
GeWafer_QQQQ.Shape ActiveWafer_QQQQ
#Come back and check this. Need to figure out where the 0,0 point is and what we are offsetting
GeWafer_QQQQ.Mother Detector_QQQQ
GeWafer_QQQQ.Position {-0.6555+Xshift} {0.0+Yshift} {Zshift}

Volume GeWaferGuardRing_QQQQ
GeWaferGuardRing_QQQQ.Material active_ge_recoil
GeWaferGuardRing_QQQQ.Visibility 1
GeWaferGuardRing_QQQQ.Color 3
GeWaferGuardRing_QQQQ.Shape GuardRing
GeWaferGuardRing_QQQQ.Position  {-0.6555+Xshift} {0.0+Yshift} {Zshift}
GeWaferGuardRing_QQQQ.Mother Detector_QQQQ

# Al dead layer on top
Shape BRIK stripsAl1_QQQQ
stripsAl1_QQQQ.Parameters 3.71 3.71 0.00025

Shape TUBE WaferCutDisk1_QQQQ
WaferCutDisk1_QQQQ.Parameters 0.0 IngotRadius 0.00025

Shape Intersection AlDead1_QQQQ
AlDead1_QQQQ.Parameters stripsAl1_QQQQ WaferCutDisk1_QQQQ

Volume stripsAl_QQQQ
stripsAl_QQQQ.Material aluminum
stripsAl_QQQQ.Visibility 1
stripsAl_QQQQ.Color 7
stripsAl_QQQQ.Shape AlDead1_QQQQ
stripsAl_QQQQ.Mother Detector_QQQQ
