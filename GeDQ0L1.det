//------------------------------------------------------------
// Detector information:
Include GeDQ0L1.geo

Strip3D               GeD_Q0L1

# Detector and Guard Ring

Volume Q0L1_GeWafer
Q0L1_GeWafer.Material active_ge_recoil
Q0L1_GeWafer.Visibility 1
Q0L1_GeWafer.Color 4
Q0L1_GeWafer.Shape Q0L1ActiveWafer
Q0L1_GeWafer.Mother Q0L1SingleDetector
Q0L1_GeWafer.Position {-0.6555} {0.0} {0.0}

Volume Q0L1GeWaferGuardRing
Q0L1GeWaferGuardRing.Material active_ge_recoil
Q0L1GeWaferGuardRing.Visibility 1
Q0L1GeWaferGuardRing.Color 3
Q0L1GeWaferGuardRing.Shape Q0L1GuardRing
Q0L1GeWaferGuardRing.Position  {-0.6555} {0.0} {0.0}
Q0L1GeWaferGuardRing.Mother Q0L1SingleDetector


GeD_Q0L1.SensitiveVolume      Q0L1_GeWafer
GeD_Q0L1.DetectorVolume       Q0L1_GeWafer

GeD_Q0L1.Offset                0.0 0.0
GeD_Q0L1.StripNumber            64  64

# COSI
GeD_Q0L1.EnergyResolution   Gauss      0.0      0.0  1.32
GeD_Q0L1.EnergyResolution   Gauss     60.0     60.0  1.32
GeD_Q0L1.EnergyResolution   Gauss    122.0    122.0  1.42
GeD_Q0L1.EnergyResolution   Gauss    365.0    365.0  1.58
GeD_Q0L1.EnergyResolution   Gauss    662.0    662.0  1.68
GeD_Q0L1.EnergyResolution   Gauss   1275.0   1275.0  1.79
GeD_Q0L1.EnergyResolution   Gauss   1836.0   1836.0  1.86

GeD_Q0L1.Overflow 1800

# Both
GeD_Q0L1.DepthResolutionThreshold 20.0
GeD_Q0L1.DepthResolution      0.0  { 0.3 / 2.35 }
GeD_Q0L1.DepthResolution     20.0  { 0.3 / 2.35 }
GeD_Q0L1.DepthResolution     50.0  { 0.1 / 2.35 }
GeD_Q0L1.DepthResolution     60.0  { 0.08 / 2.35 }
GeD_Q0L1.DepthResolution     70.0  { 0.075 / 2.35 }
GeD_Q0L1.DepthResolution     80.0  { 0.065 / 2.35 }
GeD_Q0L1.DepthResolution    122.0  { 0.06 / 2.35 }
GeD_Q0L1.DepthResolution    356.0  { 0.05 / 2.35 }
GeD_Q0L1.DepthResolution    662.0  { 0.05 / 2.35 }
GeD_Q0L1.DepthResolution   1836.0  { 0.05 / 2.35 }


# ASIC
GeD_Q0L1.TriggerThreshold     18
GeD_Q0L1.NoiseThresholdEqualsTriggerThreshold  True


# If I go smaller it gets too slow
GeD_Q0L1.EnergyPerElectron 0.2

# Jarred scaled to 1500 V
GeD_Q0L1.DriftConstant  0.007



Simple GuardRingDetector_GeD_Q0L1

GuardRingDetector_GeD_Q0L1.SensitiveVolume     Q0L1GeWaferGuardRing
GuardRingDetector_GeD_Q0L1.DetectorVolume      Q0L1GeWaferGuardRing

GuardRingDetector_GeD_Q0L1.TriggerThreshold      30
GuardRingDetector_GeD_Q0L1.NoiseThresholdEqualsTriggerThreshold true

GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 10      10        3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 20      20        3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 50      50        3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 100     100       3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 200     200       3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 500     500       3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 1000    1000      3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 2000    2000      3.3
GuardRingDetector_GeD_Q0L1.EnergyResolution Gaus 5000    5000      3.3


#------------------------------------------------------------
# Trigger information:

Trigger GeTrigger_GeD_Q0L1
GeTrigger_GeD_Q0L1.Detector GeD_Q0L1 1
GeTrigger_GeD_Q0L1.TriggerByChannel true
GeTrigger_GeD_Q0L1.Veto false


Trigger GuardRingVeto_GeD_Q0L1
GuardRingVeto_GeD_Q0L1.Veto true
GuardRingVeto_GeD_Q0L1.TriggerByChannel true
GuardRingVeto_GeD_Q0L1.Detector GuardRingDetector_GeD_Q0L1 1



