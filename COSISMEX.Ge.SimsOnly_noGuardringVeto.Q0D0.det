#------------------------------------------------------------
# Detector information:

# Attention this is the detector information for the SIMULATIONS, not for revan
# In ortder to ensure it is not usedf for the normal analysis, the trigger threshold is set x100 higher

Strip3D               GeD_0

GeD_0.SensitiveVolume      Q0D0
GeD_0.DetectorVolume       Q0D0

GeD_0.Offset               0.0 0.0
GeD_0.StripNumber          2048 2048

GeD_0.EnergyResolution   Gauss     0.0     0.0    1.04
GeD_0.EnergyResolution   Gauss    100.0    100.0  1.04
GeD_0.EnergyResolution   Gauss    300.0    300.0  1.10
GeD_0.EnergyResolution   Gauss   1000.0   1000.0  1.32
GeD_0.EnergyResolution   Gauss   3000.0   3000.0  1.94
GeD_0.EnergyResolution   Gauss  10000.0  10000.0  4.14

# Both
GeD_0.DepthResolutionThreshold 25.0
GeD_0.DepthResolution      0.0  { 0.084 / 2.35 }
GeD_0.DepthResolution     25.0  { 0.084 / 2.35 }
GeD_0.DepthResolution     50.0  { 0.070 / 2.35 }
GeD_0.DepthResolution    100.0  { 0.060 / 2.35 }
GeD_0.DepthResolution    200.0  { 0.052 / 2.35 }
GeD_0.DepthResolution    500.0  { 0.042 / 2.35 }
GeD_0.DepthResolution   1000.0  { 0.036 / 2.35 }
GeD_0.DepthResolution   2000.0  { 0.031 / 2.35 }
GeD_0.DepthResolution   5000.0  { 0.031 / 2.35 }

GeD_0.TriggerThreshold     130.
GeD_0.NoiseThresholdEqualsTriggerThreshold  True



Simple GuardRingDetector_GeD_0

GuardRingDetector_GeD_0.SensitiveVolume     GeWaferGuardRing_GeD_0
GuardRingDetector_GeD_0.DetectorVolume      GeWaferGuardRing_GeD_0

GuardRingDetector_GeD_0.TriggerThreshold      400
GuardRingDetector_GeD_0.NoiseThresholdEqualsTriggerThreshold true

GuardRingDetector_GeD_0.EnergyResolution Gaus 10      10        3
GuardRingDetector_GeD_0.EnergyResolution Gaus 20      20        3
GuardRingDetector_GeD_0.EnergyResolution Gaus 50      50        3
GuardRingDetector_GeD_0.EnergyResolution Gaus 100     100       3
GuardRingDetector_GeD_0.EnergyResolution Gaus 200     200       3
GuardRingDetector_GeD_0.EnergyResolution Gaus 500     500       3
GuardRingDetector_GeD_0.EnergyResolution Gaus 1000    1000      3
GuardRingDetector_GeD_0.EnergyResolution Gaus 2000    2000      3
GuardRingDetector_GeD_0.EnergyResolution Gaus 5000    5000      3



#------------------------------------------------------------
# Trigger information:

Trigger GeTrigger_GeD_0
GeTrigger_GeD_0.Detector GeD_0 1
GeTrigger_GeD_0.TriggerByChannel true
GeTrigger_GeD_0.Veto false

Trigger GuardRingVeto_GeD_0
GuardRingVeto_GeD_0.Veto false
GuardRingVeto_GeD_0.TriggerByChannel true
GuardRingVeto_GeD_0.Detector GuardRingDetector_GeD_0 1



