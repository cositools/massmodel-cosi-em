#------------------------------------------------------------
# Detector information:

# Attention this is the detector information for the SIMULATIONS, not for revan
# In ortder to ensure it is not usedf for the normal analysis, the trigger threshold is set x100 higher

MDVoxel3D               GeD_1

GeD_1.SensitiveVolume      Q0D1_GeWafer
GeD_1.DetectorVolume       Q0D1_GeWafer

GeD_1.Offset              0.0   0.0    0.0
GeD_1.VoxelNumber         2048   2048    2048

GeD_1.EnergyResolution Gaus 10      10        0.417
GeD_1.EnergyResolution Gaus 20      20        0.425
GeD_1.EnergyResolution Gaus 50      50        0.4375
GeD_1.EnergyResolution Gaus 100     100       0.454
GeD_1.EnergyResolution Gaus 200     200       0.492
GeD_1.EnergyResolution Gaus 500     500       0.5875
GeD_1.EnergyResolution Gaus 1000    1000      0.7217
GeD_1.EnergyResolution Gaus 2000    2000      0.9317
GeD_1.EnergyResolution Gaus 5000    5000      1.3819
GeD_1.EnergyResolution Gaus 10000   10000     1.9094
GeD_1.EnergyResolution Gaus 100000  100000    5.907

# Both
# GeD_1.DepthResolutionThreshold 25.0
# GeD_1.DepthResolution      0.0  { 0.084 / 2.35 }
# GeD_1.DepthResolution     25.0  { 0.084 / 2.35 }
# GeD_1.DepthResolution     50.0  { 0.070 / 2.35 }
# GeD_1.DepthResolution    100.0  { 0.060 / 2.35 }
# GeD_1.DepthResolution    200.0  { 0.052 / 2.35 }
# GeD_1.DepthResolution    500.0  { 0.042 / 2.35 }
# GeD_1.DepthResolution   1000.0  { 0.036 / 2.35 }
# GeD_1.DepthResolution   2000.0  { 0.031 / 2.35 }
# GeD_1.DepthResolution   5000.0  { 0.031 / 2.35 }

GeD_1.TriggerThreshold     13.
GeD_1.NoiseThresholdEqualsTriggerThreshold  True

GeD_1.FailureRate 0.0

MDVoxel3D GuardRingDetector_Q0D1

GuardRingDetector_Q0D1.SensitiveVolume     GeWaferGuardRing_Q0D1
GuardRingDetector_Q0D1.DetectorVolume      GeWaferGuardRing_Q0D1

GuardRingDetector_Q0D1.Offset              0.0   0.0    0.0
GuardRingDetector_Q0D1.VoxelNumber         2048   2048    2048

GuardRingDetector_Q0D1.TriggerThreshold      40
GuardRingDetector_Q0D1.NoiseThresholdEqualsTriggerThreshold true

GuardRingDetector_Q0D1.EnergyResolution Gaus 10      10        3
GuardRingDetector_Q0D1.EnergyResolution Gaus 20      20        3
GuardRingDetector_Q0D1.EnergyResolution Gaus 50      50        3
GuardRingDetector_Q0D1.EnergyResolution Gaus 100     100       3
GuardRingDetector_Q0D1.EnergyResolution Gaus 200     200       3
GuardRingDetector_Q0D1.EnergyResolution Gaus 500     500       3
GuardRingDetector_Q0D1.EnergyResolution Gaus 1000    1000      3
GuardRingDetector_Q0D1.EnergyResolution Gaus 2000    2000      3
GuardRingDetector_Q0D1.EnergyResolution Gaus 5000    5000      3



#------------------------------------------------------------
# Trigger information:

Trigger GeTrigger_Q0D1
GeTrigger_Q0D1.Detector GeD_1 1
GeTrigger_Q0D1.TriggerByChannel true
GeTrigger_Q0D1.Veto false

Trigger GuardRingVeto_Q0D1
GuardRingVeto_Q0D1.Veto true
GuardRingVeto_Q0D1.TriggerByChannel true
GuardRingVeto_Q0D1.Detector GuardRingDetector_Q0D1 1



