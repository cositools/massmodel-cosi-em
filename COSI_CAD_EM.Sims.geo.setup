#Detector stack

Volume DetectorStackWrapper
DetectorStackWrapper.Shape BRIK 1000 1000 1000
DetectorStackWrapper.Material Vacuum
DetectorStackWrapper.Visibility 0
#DetectorStackWrapper.Position 0 0 0.064
DetectorStackWrapper.Position 0 0 {0.064-0.001128+0.000002}
DetectorStackWrapper.Rotation 0 0 0
DetectorStackWrapper.Virtual True
DetectorStackWrapper.Mother DetectorStackHolderWrapper

#For a single detector

#X-position is CAD holder position {-7.639} + constants + shift
#Y-position is CAD holder position {-0.752} + constants + shift
#Z-position is CAD holder position {23.298} + shift

#Singledetector X position: -7.639 + IngotRadius - DetectorHalfWidth + GuardRingSize + 0.73455295178
#Singledetector Y position: -0.752-DetectorHalfWidth+GuardRingSize+0.0119285
#Singledetector Z position: 23.298+0.052831

Constant SingledetectorX {-7.639+2.08955295178}
Constant SingledetectorY {-0.752-3.7130715}
Constant SingledetectorZ  {23.298+0.052831}


# --------------------------

Constant Q0_xshift -0.018219

# Q0L0 Detector

Volume DetectorQ0L0Wrapper
